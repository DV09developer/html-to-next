{
    "name": "html-to-next",
    "version": "0.0.0",
    "private": true,
    "description": "AI-powered HTML to Next.js component conversion platform",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.9.1",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.9.1",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.9",
        "turbo": "^2.11.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vitest": "^5.0.3"
    }
}
